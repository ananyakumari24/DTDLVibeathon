# Copy to .env and fill in. .env is gitignored, never commit it.
# Claude (used first when set; a key from platform.claude.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Model for the pipeline's labelling calls (defaults to ANTHROPIC_MODEL; claude-haiku-5-5 is
# cheaper but labelled question type less accurately), and how many LLM calls run at once
# ANTHROPIC_LABEL_MODEL=
# LLM_WORKERS=16
# Only if the key is not scoped to a workspace (Console > Workspaces, the wrkspc_... ID)
# ANTHROPIC_WORKSPACE_ID=

# Or OpenAI (also gives the LiveKit voice agent OpenAI speech models)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Or use Cursor instead (a User API key from cursor.com/dashboard, needs cursor-agent installed)
# CURSOR_API_KEY=
# CURSOR_MODEL=

# Only for scripts/run.sh livekit
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
